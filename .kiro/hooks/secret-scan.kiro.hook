{
  "name": "Scan for booking references",
  "description": "Before any commit-related work, greps the working tree for known booking reference patterns and blocks if found outside secrets.enc.json.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["**/*.js", "**/*.json", "**/*.md", "**/*.html"] },
  "then": {
    "type": "askAgent",
    "prompt": "Run `bash tools/precommit-secret-scan.sh --tree`. If it reports any match outside data/secrets.enc.json, stop, tell Matt exactly which file and line, and do not proceed with any git operation."
  }
}
